<%- include('partials/header.ejs') %>

<h2><%= filter ?? 'All Works' %></h2>
<form action="/works" method="GET">
    <label for="searchInput"></label>
    <input type="text" id="searchInput" name="filter" value="<%= filter %>">
    <button type="submit" class="searchButton">Search</button>
    <select id="searchTypeSelect" name="filterType">
        <option value="title" <%= "title" === filterType ? 'selected' : '' %>>Title</option>
<!--        TODO: FIX AUTHOR SEARCH-->
        <option value="author" <%= "author" === filterType ? 'selected' : '' %>>Author</option>
        <option value="fandom" <%= "fandom" === filterType ? 'selected' : '' %>>Fandom</option>
        <option value="relationship" <%= "relationship" === filterType ? 'selected' : '' %>>Relationship</option>
        <option value="tag" <%= "tag" === filterType ? 'selected' : '' %>>Tag</option>
    </select>
</form>
<p class="shownCount">Showing <%= works.length %> of <%= totalWorksCount %></p>
<% for (work of works) { %>
    <article class="card">
        <h3><a href="/work"><%= work.title %></a> by <a href="/works"><%= work.author %></a></h3>
        <div>
        <h4>Fandoms: </h4>
            <% for (tag of work.fandomTags) { %>
                <a href="/works?filterType=fandom&filter=<%= encodeURIComponent(tag) %>"> <%= tag %></a>,
            <% } %>
        </div>
        <div>
        <h4>Relationships: </h4>
            <% for (tag of work.relationshipTags) { %>
                  <a href="/works?filterType=relationship&filter=<%= encodeURIComponent(tag) %>"><%= tag %></a>,
            <% } %>
        </div>
        <div>
        <h4>Tags: </h4> 
            <% for (tag of work.generalTags) { %>
                <a href="/works?filterType=tag&filter=<%= encodeURIComponent(tag) %>"><%= tag %></a>,
            <% } %>
        </div>
        <p><%= work.summary %></p>
    </article>
<% } %>

<%- include('partials/footer.ejs') %>
