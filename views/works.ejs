<!DOCTYPE html>
<html>
<head>
    <title>Works</title>
    <link rel='stylesheet' href='public/stylesheets/style.css'/>
</head>
<body>
<header>
    <div>
    <h1>ArchiveOfJustUsTwo</h1>
    <a href='/'>Home</a>
    <a href='/publish'>Publish</a>
    <a href='/login'>Login</a>
    </div>
</header>
<h2><%= filter ?? 'All Works' %></h2>
<form action="/" method="GET">
    <label for="searchInput"></label>
    <input type="text" id="searchInput" value="<%= filter %>">
    <button type="submit">Search</button>
    <select id="searchTypeSelect">
        <option value="title" <%= "title" === filterType ? 'selected' : '' %>>Title</option>
        <option value="author" <%= "author" === filterType ? 'selected' : '' %>>Author</option>
        <option value="fandom" <%= "fandom" === filterType ? 'selected' : '' %>>Fandom</option>
        <option value="relationship" <%= "relationship" === filterType ? 'selected' : '' %>>Relationship</option>
        <option value="tag" <%= "tag" === filterType ? 'selected' : '' %>>Tag</option>
    </select>
</form>
<p>Showing <%= works.length %> of <%= totalWorksCount %></p>
<!--TODO: Fix Links-->
<% for (work of works) { %>
    <article>
        <h3><a href="/work"><%= work.title %></a></h3>
        <h3><a href="/works">By: <%= work.author %></a></h3>
        <div>
        <h4>Fandoms: </h4>
            <% for (tag of work.fandoms) { %>
                <a href="<%= tag %>"><%= tag %></a>,
            <% } %>
        </div>
        <div>
        <h4>Relationships: </h4>
            <% for (tag of work.relationships) { %>
                <a href="<%= tag %>"><%= tag %></a>,
            <% } %>
        </div>
        <div>
        <h4>Tags: </h4>
            <% for (tag of work.tags) { %>
                <a href="<%= tag %>"><%= tag %></a>,
            <% } %>
        </div>
    </article>
<% } %>
<div class="footer"></div>
</body>
</html>